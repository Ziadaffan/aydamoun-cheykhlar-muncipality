generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ServiceType {
  LICENSEES_AND_CONSTRUCTION_SERVICES
  ENVIRONMENTAL_SERVICES
  ADMINISTRATIVE_SERVICES
  DOWNLOAD_OFFICIAL_FORMS_SERVICES
  COMPLAINTS_AND_SUGGESTIONS_SERVICES
  OTHER
}

enum Position {
  PRESIDENT
  VICE_PRESIDENT
  COUNCIL_MEMBER
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NewsCategory {
  MUNICIPAL_NEWS
  DEVELOPMENT_PROJECTS
  ANNOUNCEMENTS
  COMMUNITY_EVENTS
  INFRASTRUCTURE
  ENVIRONMENTAL
  SOCIAL_SERVICES
  HEALTH_AND_SOCIAL_SERVICES
  OTHER
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String?             @unique
  phone         String?             @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role                @default(USER)
  accounts      Account[]
  sessions      Session[]
  submissions   ServiceSubmission[]
  pushTokens    PushToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Council {
  id       String   @id @default(uuid())
  name     String
  position Position
  phone    String?
  email    String?
  image    String?
  /// Duty in the municipality, e.g. "رئيس لجنة الأشغال".
  role     String?
  /// Field of study / profession, e.g. "مهندس مدني".
  major    String?
  order    Int      @default(0)

  /// English versions (optional; Arabic is shown when empty).
  nameEn    String?
  roleEn    String?
  majorEn   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String              @id @default(uuid())
  name        String
  description String
  type        ServiceType
  /// ServiceField[] (see src/packages/services/utils/serviceFields.ts); null = the category defaults.
  fields      Json?
  active      Boolean             @default(true)
  order       Int                 @default(0)
  submissions ServiceSubmission[]

  /// English versions (optional; Arabic is shown when empty).
  nameEn        String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceSubmission {
  id             String        @id @default(uuid())
  fullName       String
  phone          String
  email          String?
  address        String
  description    String?
  additionalInfo Json
  status         ServiceStatus @default(PENDING)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id       String       @id @default(uuid())
  title    String
  content  String       @db.Text
  excerpt  String
  imageUrl String[]
  category NewsCategory
  author   String
  views    Int          @default(0)
  featured Boolean      @default(false)

  tags      String[]
  createdBy String

  /// English versions (optional; Arabic is shown when empty).
  titleEn   String?
  contentEn String?  @db.Text
  excerptEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model Document {
  id          String  @id @default(uuid())
  title       String
  description String?
  type        String
  fileUrl     String

  /// English versions (optional; Arabic is shown when empty).
  titleEn       String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Jobs {
  id          String    @id @default(uuid())
  title       String
  description String?
  provider    String
  phone       String?
  location    String
  salary      String?
  deadline    DateTime?
  active      Boolean   @default(true)

  /// English versions (optional; Arabic is shown when empty).
  titleEn       String?
  descriptionEn String?
  providerEn    String?
  locationEn    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Association {
  id          String @id @default(uuid())
  name        String
  description String
  picaURL     String

  /// English versions (optional; Arabic is shown when empty).
  nameEn        String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TaxiStop {
  id           String @id @default(uuid())
  name         String
  fromLocation String
  toLocation   String
  hour         String
  phone        String

  /// English versions (optional; Arabic is shown when empty).
  nameEn         String?
  fromLocationEn String?
  toLocationEn   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Expo push tokens of app installs, signed in or not: every install hears
// about new news, jobs and taxi stops.
model PushToken {
  id       String   @id @default(uuid())
  token    String   @unique
  platform String
  /// "ar" | "en": the language the install's notifications are written in.
  locale   String   @default("ar")
  /// Subscribed topics: announcements, news, jobs, taxiStops, requests.
  topics   String[] @default(["announcements", "news", "jobs", "taxiStops", "requests"])
  /// Last signed-in user of the install, for personal notifications (request status).
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Announcement {
  id        String               @id @default(uuid())
  title     String
  body      String               @db.Text
  /// Cloudinary public id or https URL.
  imageUrl  String?
  priority  AnnouncementPriority @default(NORMAL)
  pinned    Boolean              @default(false)
  /// Hidden from public lists after this.
  expiresAt DateTime?
  /// Admin user id.
  createdBy String

  /// English versions (optional; Arabic is shown when empty).
  titleEn   String?
  bodyEn    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Village history timeline, managed by admins.
model HistoryEntry {
  id          String  @id @default(uuid())
  /// Free text: "1920", "القرن التاسع عشر", "1975 – 1990".
  period      String
  title       String
  description String  @db.Text
  imageUrl    String?
  /// Ascending = chronological.
  order       Int     @default(0)

  /// English versions (optional; Arabic is shown when empty).
  periodEn      String?
  titleEn       String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
